# ============================================================================
# LifeBookz backend microservice architecture — GLOBAL variables
# ============================================================================
# Copy to `.env` for local development. Every variable here is *documented*
# centrally; each deployable unit only receives the subset it actually needs
# (see services/<name>/.env.example and workers/<name>/.env.example).
#
# In AWS, none of these are hard-coded into the Lambda code: values are passed
# through Serverless `provider.environment` (built from CloudFormation exports
# and stage variables). Secrets are referenced from AWS Secrets Manager /
# Parameter Store — never stored in this file for production.
# ============================================================================

# ---------------------------------------------------------------- environment
NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""
# Comma separated list of Cloudflare/AWS log groups is not needed; Lambda logs
# go to CloudWatch automatically.

# ------------------------------------------------------------------- platform
# Created once by the `system` stack and imported by every other stack.
HTTP_API_ID=""
JWT_AUTHORIZER_ID=""
EVENT_BUS_NAME="lifebookz-events"
EVENT_BUS_ARN=""

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177"

# API custom domain (managed in the system stack)
API_DOMAIN_NAME="api.lifebookz.com"
API_CERTIFICATE_ARN=""

# ------------------------------------------------------------------- identity
# Auth is the only issuer. Business services never sign or verify JWTs.
JWT_ISSUER="https://api.lifebookz.com"
JWT_AUDIENCE="lifebookz-api"
JWT_KID="lifebookz-auth-2026-09"
JWT_PRIVATE_KEY_SECRET_ID="lifebookz/auth/jwt-signing-key"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"

# Service-to-service token used by `system` -> `auth` for admin decisions.
INTERNAL_SERVICE_TOKEN_SECRET_ID="lifebookz/internal/service-token"

# ------------------------------------------------------------ MongoDB clusters
# One Atlas cluster per business service (workload + failure isolation).
# Read at cold start from Secrets Manager in production:
#   MONGODB_AUTH_URI_SECRET_ID="lifebookz/auth/mongodb-uri"
#   MONGODB_STORY_URI_SECRET_ID="lifebookz/story/mongodb-uri"
#   MONGODB_CONSULTATION_URI_SECRET_ID="lifebookz/consultation/mongodb-uri"
#   MONGODB_NOTIFICATION_URI_SECRET_ID="lifebookz/notification/mongodb-uri"
#   MONGODB_SYSTEM_URI_SECRET_ID="lifebookz/system/mongodb-uri"
MONGODB_AUTH_URI=""
MONGODB_STORY_URI=""
MONGODB_CONSULTATION_URI=""
MONGODB_NOTIFICATION_URI=""
MONGODB_SYSTEM_URI=""

# ------------------------------------------------------------------- DynamoDB
# Stateful, TTL-backed counters (OTP abuse protection) + email idempotency.
DYNAMODB_OTP_LIMITS_TABLE="lifebookz-auth-otp-limits"
DYNAMODB_EMAIL_IDEMPOTENCY_TABLE="lifebookz-email-idempotency"

# ------------------------------------------------------------------------ SES
SES_REGION="ap-south-1"
SES_FROM_EMAIL="noreply@lifebookz.com"
SES_FROM_NAME="LifeBookz"
SES_REPLY_TO="support@lifebookz.com"

# ------------------------------------------------------------------------ SQS
SQS_EMAIL_QUEUE_URL=""
SQS_EMAIL_DLQ_URL=""
SQS_EMAIL_QUEUE_ARN=""

SQS_ANALYTICS_QUEUE_URL=""
SQS_ANALYTICS_DLQ_URL=""
SQS_ANALYTICS_QUEUE_ARN=""

# Per-service inbound event queues (EventBridge -> SQS -> Lambda)
SQS_STORY_EVENTS_QUEUE_URL=""
SQS_CONSULTATION_EVENTS_QUEUE_URL=""
SQS_NOTIFICATION_EVENTS_QUEUE_URL=""
SQS_SYSTEM_EVENTS_QUEUE_URL=""

# -------------------------------------------------- analytics (S3 + Athena)
ANALYTICS_S3_BUCKET="lifebookz-analytics"
ANALYTICS_S3_PREFIX="events/"
ATHENA_DATABASE="lifebookz_analytics"
ATHENA_WORKGROUP="primary"
ATHENA_OUTPUT_LOCATION="s3://lifebookz-athena-results/query-results/"

# ----------------------------------------------------------------- Cloudflare R2
# Application media only (story media, profile media). Analytics never uses R2.
R2_ACCOUNT_ID=""
R2_API_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="lifebookz"
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""

# -------------------------------------------------------------------- payments
# NOTE: verified — the existing backend has zero references to Razorpay. The
# variable is documented for parity but no service code consumes it yet.
RAZORPAY_API_KEY=""

# -------------------------------------------------------------------- frontends
FRONTEND_CLIENT_URL="http://localhost:5173"
FRONTEND_AUTHOR_URL="http://localhost:5174"
FRONTEND_ADMIN_URL="http://localhost:5175"
FRONTEND_EXPERT_URL="http://localhost:5176"
FRONTEND_DEVELOPER_URL="http://localhost:5177"

# --------------------------------------------------------------- admin/develop
# Privileged identities are NOT stored in MongoDB; credentials come from
# Secrets Manager (`lifebookz/admin-credentials`, `lifebookz/developer-credentials`).
ADMIN_EMAIL="admin@lifebookz.com"
ADMIN_CREDENTIALS_SECRET_ID="lifebookz/admin-credentials"
DEVELOPER_EMAIL=""
DEVELOPER_CREDENTIALS_SECRET_ID="lifebookz/developer-credentials"
