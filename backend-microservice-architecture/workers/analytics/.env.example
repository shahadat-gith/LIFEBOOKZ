# ---------------------------------------------------------------------------
# Analytics worker — environment contract.
# Copy to `.env` for local development. Never commit `.env`.
# In AWS, S3 authorization comes from the Lambda execution role.
# ---------------------------------------------------------------------------

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

SERVICE_NAME="analytics-worker"

# The queue this worker consumes (owned by the `system` stack in AWS).
# Local: paste the real queue URL or leave empty and run tests only.
SQS_ANALYTICS_QUEUE_URL=""

# Where analytics records land (Hive-partitioned).
ANALYTICS_S3_BUCKET="lifebookz-analytics"
ANALYTICS_S3_PREFIX="events/"

# Athena (query-side configuration only — the worker itself never calls Athena).
ATHENA_DATABASE="lifebookz_analytics"
ATHENA_WORKGROUP="primary"
ATHENA_OUTPUT_LOCATION="s3://lifebookz-athena-results/query-results/"
