# ---------------------------------------------------------------------------
# Email worker — environment contract.
# Copy to `.env` for local development. Never commit `.env`.
# In AWS, SES authorization comes from the Lambda execution role — there are
# no AWS access keys anywhere in this architecture.
# ---------------------------------------------------------------------------

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

SERVICE_NAME="email-worker"

# The queue this worker consumes (owned by the `system` stack in AWS).
# Local: paste the real queue URL or leave empty and run tests only.
SQS_EMAIL_QUEUE_URL=""

# SES identity.
SES_REGION="ap-south-1"
SES_FROM_EMAIL="noreply@lifebookz.com"
SES_FROM_NAME="LifeBookz"
SES_REPLY_TO=""
# Optional SES configuration set (bounce/complaint handling).
SES_CONFIGURATION_SET=""

# Idempotency table (created by this stack; set here only for local testing).
DYNAMODB_IDEMPOTENCY_TABLE="lifebookz-email-worker-idempotency-dev"
