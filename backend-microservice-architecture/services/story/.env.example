# ============================================================================
# services/story — environment contract
# ============================================================================

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

# --- platform ---------------------------------------------------------------
EVENT_BUS_NAME="lifebookz-events"

# --- MongoDB (Story cluster only) -------------------------------------------
MONGODB_STORY_URI_SECRET_ID="lifebookz/story/mongodb-uri"
# MONGODB_STORY_URI="mongodb+srv://…"          # local development only
MONGO_MAX_POOL_SIZE="15"

# --- inbound events ---------------------------------------------------------
SQS_STORY_EVENTS_QUEUE_URL=""

# --- Cloudflare R2 (story media + author avatars/covers) ---------------------
R2_BUCKET_NAME="lifebookz"
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- domain tuning ----------------------------------------------------------
FEED_PAGE_SIZE="12"
MAX_CHAPTERS="50"
FRONTEND_CLIENT_URL="http://localhost:5173"

# Publish fan-out cap (followers notified per publish event; EventBridge is
# capped at 256 KB, so the list is bounded).
MAX_PUBLISH_FANOUT="500"
