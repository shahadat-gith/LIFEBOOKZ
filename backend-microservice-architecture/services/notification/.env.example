# ---------------------------------------------------------------------------
# Notification service — local development only. Copy to `.env`.
# In AWS the secrets come from Secrets Manager (see the root README).
# ---------------------------------------------------------------------------

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

SERVICE_NAME="notification"

EVENT_BUS_NAME="lifebookz-events"

# This service's own Atlas cluster.
MONGODB_NOTIFICATION_URI="mongodb+srv://user:pass@notification-cluster.mongodb.net/lifebookz_notification?retryWrites=true&w=majority"
MONGODB_NOTIFICATION_URI_SECRET_ID="lifebookz/notification/mongodb-uri"

MONGO_MAX_POOL_SIZE="10"
MAX_NOTIFICATION_FANOUT="500"
MAX_NOTIFICATIONS_PER_PAGE="50"

# The queue this service consumes.
SQS_NOTIFICATION_EVENTS_QUEUE_URL="https://sqs.ap-south-1.amazonaws.com/000000000000/lifebookz-notification-events-queue-dev"

# The email worker's queue. Leave empty offline: notification creation still
# succeeds and the failed enqueue is logged (never thrown).
SQS_EMAIL_QUEUE_URL=""

FRONTEND_CLIENT_URL="http://localhost:5173"
FRONTEND_AUTHOR_URL="http://localhost:5174"
FRONTEND_EXPERT_URL="http://localhost:5176"
