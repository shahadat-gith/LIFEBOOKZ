# ---------------------------------------------------------------------------
# Consultation service — local development only.
# Copy to `.env` and fill in. Never commit `.env`.
# In AWS, everything secret comes from Secrets Manager / SSM instead; see the
# root README section 15 (environment variables).
# ---------------------------------------------------------------------------

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

SERVICE_NAME="consultation"

# Shared event bus (created by the `system` stack).
EVENT_BUS_NAME="lifebookz-events"

# This service's own Atlas cluster. Exactly one cluster per service.
MONGODB_CONSULTATION_URI="mongodb+srv://user:pass@consultation-cluster.mongodb.net/lifebookz_consultation?retryWrites=true&w=majority"
MONGODB_CONSULTATION_URI_SECRET_ID="lifebookz/consultation/mongodb-uri"

# Lambda connection pool. 40 reserved containers × 10 = 400 sockets.
MONGO_MAX_POOL_SIZE="10"

# Matching.
MATCH_DEFAULT_LIMIT="5"

# Queue this service consumes (EventBridge → SQS → consumer Lambda).
SQS_CONSULTATION_EVENTS_QUEUE_URL="https://sqs.ap-south-1.amazonaws.com/000000000000/lifebookz-consultation-events-queue-dev"

# Media stays in Cloudflare R2. S3 is analytics only.
R2_BUCKET_NAME="lifebookz"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://media.lifebookz.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# CORS/email links for the portals that consume this API.
FRONTEND_CLIENT_URL="http://localhost:5173"
FRONTEND_EXPERT_URL="http://localhost:5176"
