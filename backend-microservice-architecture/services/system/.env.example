# ---------------------------------------------------------------------------
# System service — environment contract.
# Copy to `.env` for local development. Never commit `.env`.
# In AWS, secrets come from Secrets Manager; AWS access is via the Lambda
# execution role (no keys anywhere in this architecture).
# ---------------------------------------------------------------------------

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

SERVICE_NAME="system"

# Shared platform (owned by this very stack in AWS; local: names only).
EVENT_BUS_NAME="lifebookz-events"

# This service's own Atlas cluster. Exactly one cluster per service.
MONGODB_SYSTEM_URI="mongodb+srv://user:pass@system-cluster.mongodb.net/lifebookz_system?retryWrites=true&w=majority"
MONGODB_SYSTEM_URI_SECRET_ID="lifebookz/system/mongodb-uri"

# Lambda connection pool. 10 reserved containers × 10 = 100 sockets.
MONGO_MAX_POOL_SIZE="10"

# Admin review list page size.
ADMIN_LIST_LIMIT="100"

# Calling Auth's internal verification endpoint (service-to-service).
AUTH_API_BASE_URL="https://api.lifebookz.com"
INTERNAL_SERVICE_TOKEN_SECRET_ID="lifebookz/internal/service-token"
# Local only — in AWS the value comes from Secrets Manager:
# INTERNAL_SERVICE_TOKEN="local-dev-service-token"

# Developer portal: CloudWatch log group for operational logs.
DEVELOPER_LOG_GROUP="/aws/lambda/lifebookz-dev-api"

# The analytics bucket this stack creates (name needed for env wiring only).
ANALYTICS_S3_BUCKET="lifebookz-analytics"

# JWT authorizer configuration (this stack defines the authorizer itself).
JWT_ISSUER="https://api.lifebookz.com"
JWT_AUDIENCE="lifebookz-api"

# CORS: the real frontend origins.
FRONTEND_CLIENT_URL="http://localhost:5173"
FRONTEND_AUTHOR_URL="http://localhost:5174"
FRONTEND_ADMIN_URL="http://localhost:5175"
FRONTEND_EXPERT_URL="http://localhost:5176"
FRONTEND_DEVELOPER_URL="http://localhost:5177"
