# ============================================================================
# services/auth — environment contract
# ============================================================================
# Only these variables are passed to the Auth Lambda. Everything else (Story's
# Mongo URI, the analytics bucket, …) is deliberately absent: a service only
# receives what it needs.
# ============================================================================

NODE_ENV="dev"
AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

# --- platform (imported from the `system` stack in production) ---------------
EVENT_BUS_NAME="lifebookz-events"
HTTP_API_ID=""
JWT_AUTHORIZER_ID=""

# --- identity ---------------------------------------------------------------
JWT_ISSUER="https://api.lifebookz.com"
JWT_AUDIENCE="lifebookz-api"
JWT_KID="lifebookz-auth-2026-09"
ACCESS_TOKEN_TTL_SECONDS="900"
REFRESH_TOKEN_TTL_DAYS="30"

# --- secrets (ids only; values live in Secrets Manager) ----------------------
MONGODB_AUTH_URI_SECRET_ID="lifebookz/auth/mongodb-uri"
JWT_PRIVATE_KEY_SECRET_ID="lifebookz/auth/jwt-signing-key"
INTERNAL_SERVICE_TOKEN_SECRET_ID="lifebookz/internal/service-token"
ADMIN_CREDENTIALS_SECRET_ID="lifebookz/admin-credentials"
DEVELOPER_CREDENTIALS_SECRET_ID="lifebookz/developer-credentials"

# --- local development only (never used in production) ---------------------
# MONGODB_AUTH_URI="mongodb+srv://user:pass@auth-cluster.mongodb.net/lifebookz_auth"
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----"
# INTERNAL_SERVICE_TOKEN="local-dev-service-token"
# ADMIN_EMAIL="admin@lifebookz.com"
# ADMIN_PASSWORD=""
# DEVELOPER_EMAIL=""
# DEVELOPER_PASSWORD=""

# --- abuse protection (DynamoDB, TTL) ---------------------------------------
DYNAMODB_OTP_LIMITS_TABLE="lifebookz-auth-otp-limits-dev"
OTP_REQUEST_LIMIT_PER_HOUR="3"
OTP_VERIFY_LIMIT_PER_HOUR="5"
LOGIN_ATTEMPT_LIMIT="10"
OTP_TTL_SECONDS="600"
RESET_TOKEN_TTL_SECONDS="300"
BCRYPT_ROUNDS="12"

# --- MongoDB Lambda pool (see services/auth/README.md for the reasoning) -----
MONGO_MAX_POOL_SIZE="10"

# --- Cloudflare R2 (reader avatars and covers only) -------------------------
R2_BUCKET_NAME="lifebookz"
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- key rotation (optional; used only while rotating the signing key) -------
# JWT_PUBLIC_KEY=""
# JWT_PREVIOUS_KID=""
# JWT_PREVIOUS_PUBLIC_KEY=""
