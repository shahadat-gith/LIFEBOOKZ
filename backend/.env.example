
# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV="dev"
PORT=5000


# ============================================================
# MONGODB
# One MongoDB Atlas cluster can host these separate databases.
# ============================================================

MONGODB_AUTH_DB=""
MONGODB_STORY_DB=""
MONGODB_CONSULTATION_DB=""
MONGODB_NOTIFICATION_DB=""
MONGODB_SYSTEM_DB=""


# ============================================================
# AUTHENTICATION / SECURITY
# ============================================================

JWT_SECRET=""

# Admin
ADMIN_EMAIL="admin@lifebookz.com"
ADMIN_PASSWORD=""
ADMIN_KEY=""

# Developer
DEVELOPER_EMAIL="shahadat.offl@gmail.com"
DEVELOPER_PASSWORD=""


# ============================================================
# AWS
# ============================================================

AWS_REGION="ap-south-1"
AWS_ACCOUNT_ID=""

# Do NOT put AWS access keys here for Lambda.
# Lambda should use its IAM execution role.
#
# For local development, configure credentials through:
# AWS CLI / AWS profile / environment variables outside this file.
#
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""


# ============================================================
# AWS SES - EMAIL
# ============================================================

SES_REGION="ap-south-1"
SES_FROM_EMAIL="noreply@lifebookz.com"
SES_FROM_NAME="LifeBookz"


# ============================================================
# AMAZON EVENTBRIDGE
# Domain events between services
# ============================================================

EVENT_BUS_NAME="lifebookz-events"
EVENT_BUS_ARN=""


# ============================================================
# AMAZON SQS - EMAIL
# Notification service -> Email Worker
# ============================================================

SQS_EMAIL_QUEUE_URL=""
SQS_EMAIL_DLQ_URL=""


# ============================================================
# AMAZON SQS - ANALYTICS
# EventBridge -> Analytics Worker
# ============================================================

SQS_ANALYTICS_QUEUE_URL=""
SQS_ANALYTICS_DLQ_URL=""


# ============================================================
# ANALYTICS - AMAZON S3
# Analytics data is stored in S3.
# Athena queries the data in S3.
# ============================================================

ANALYTICS_S3_BUCKET=""
ANALYTICS_S3_PREFIX="events/"


# ============================================================
# AMAZON ATHENA
# Used for querying analytics data stored in S3.
# ============================================================

ATHENA_DATABASE=""
ATHENA_WORKGROUP="primary"
ATHENA_OUTPUT_LOCATION=""


# ============================================================
# CLOUDFLARE R2
# Application media / uploaded files
# ============================================================

R2_ACCOUNT_ID=""
R2_API_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

R2_BUCKET_NAME="lifebookz"

R2_ENDPOINT="https://f4fa948f209e336d0c3276a87c44716d.r2.cloudflarestorage.com"

R2_PUBLIC_BASE_URL="https://pub-693d47ae7a8a407ba91ee585ec516842.r2.dev"


# ============================================================
# RAZORPAY
# ============================================================

RAZORPAY_API_KEY=""


# ============================================================
# FRONTEND URLS
# ============================================================

FRONTEND_CLIENT_URL="http://localhost:5173"
FRONTEND_AUTHOR_URL="http://localhost:5174"
